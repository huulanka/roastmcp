<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The window shows the UI served by the local daemon on 127.0.0.1. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>RoastMCP connects to Bluetooth coffee roasters.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>RoastMCP listens for first and second crack while a roast is recorded. The sound stays on this Mac.</string>
</dict>
</plist>
